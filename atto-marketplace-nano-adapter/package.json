{
  "name": "@attocash/atto-marketplace-nano-adapter",
  "version": "0.1.0",
  "description": "Private Node Nano wallet adapter with bounded spending and durable recovery",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attocash/integrations.git",
    "directory": "atto-marketplace-nano-adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.2.0",
    "@attocash/cli": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "private": true
}
